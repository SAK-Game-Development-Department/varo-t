# SkyWay (https://skyway.ntt.com, Free plan) — used for new rooms when the
# Cloudflare relay is past its daily budget or unreachable. Copy to .env.local
# and fill in from the SkyWay console (アプリケーション → App ID / シークレットキー).
# Leave empty to run without SkyWay.
VITE_SKYWAY_APP_ID=
VITE_SKYWAY_SECRET=
